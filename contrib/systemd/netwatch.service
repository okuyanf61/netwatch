[Unit]
Description=netwatch - minimal internet uptime monitor
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/netwatch/netwatch.py
Environment=NETWATCH_DB=/var/lib/netwatch/netwatch.db
Environment=NETWATCH_PORT=8080
Environment=NETWATCH_INTERVAL=60
Environment=NETWATCH_RETENTION_DAYS=365
Restart=always
RestartSec=5

# Unprivileged throwaway user; data lives in /var/lib/netwatch
DynamicUser=yes
StateDirectory=netwatch
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Nice=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
